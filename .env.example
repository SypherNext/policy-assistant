# Settings read by policy_assistant/config.py. The values below are the defaults, so you only
# need these when you change something. The code does not load this file by itself: set the
# variables in your shell (see "Run the app" in README.md).
OLLAMA_URL=http://localhost:18211
# The password is the throwaway value for the local container in the README. Use your own.
PG_DSN=postgresql://rag:ragpass@localhost:18232/policies
EMBED_MODEL=nomic-embed-text
CHAT_MODEL=qwen2.5:3b
# POLICY_DIR defaults to the policies/ folder next to policy_assistant/
# POLICY_DIR=/path/to/your/policies
